{
    "name": "threejs-landscapes",
    "version": "0.0.2",
    "description": "Experiments with ThreeJS",
    "author": "aljazmc",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/threejs-landscapes.git"
    },
    "dependencies": {
        "@aljazmc/ptuj": "workspace:*",
        "@aljazmc/starter": "workspace:*"
    },
    "devDependencies": {
        "@aljazmc/formatero": "^0.4.0",
        "@aljazmc/lintero": "^0.4.0",
        "@aljazmc/monorepo": "^0.3.0",
        "@aljazmc/testero": "^0.3.0",
        "esbuild": "0.28.2",
        "typescript": "^7.0.2",
        "unrs-resolver": "^1.12.2"
    },
    "resolutions": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.186.0",
        "esbuild": "0.28.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "three": "0.186.1",
        "unrs-resolver": "1.12.2"
    },
    "packageManager": "yarn@4.18.1",
    "workspaces": [
        "packages/**"
    ],
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || ^24 || ^25 || ^26",
        "npm": "Please use yarn instead of NPM to install dependencies",
        "pnpm": "Please use yarn instead of PNPM to install dependencies",
        "yarn": ">=4.12.0"
    },
    "scripts": {
        "b:all": "yarn workspaces foreach -A run build",
        "b:ptuj": "yarn workspace @aljazmc/ptuj run build",
        "b:starter": "yarn workspace @aljazmc/starter run build",
        "bp:all": "yarn workspaces foreach -A run build:p",
        "bp:ptuj": "yarn workspace @aljazmc/ptuj run build:p",
        "bp:starter": "yarn workspace @aljazmc/starter run build:p",
        "ct:all": "yarn workspaces foreach -A run checktypes",
        "ct:ptuj": "tsc -b --noEmit packages/ptuj",
        "ct:starter": "tsc -b --noEmit packages/starter",
        "lint": "lintero && formatero",
        "lint:w": "lintero --write && formatero --write",
        "lint:wu": "lintero --write --unsafe && formatero --write",
        "s:ptuj": "yarn workspace @aljazmc/ptuj run serve",
        "s:starter": "yarn workspace @aljazmc/starter run serve",
        "sp:ptuj": "yarn workspace @aljazmc/ptuj run serve:p",
        "sp:starter": "yarn workspace @aljazmc/starter run serve:p",
        "test": "testero",
        "w:ptuj": "yarn workspace @aljazmc/ptuj run watch",
        "w:starter": "yarn workspace @aljazmc/starter run watch"
    }
}
