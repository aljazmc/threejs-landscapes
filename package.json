{
    "name": "threejs-landscapes",
    "version": "0.0.5",
    "description": "Experiments with ThreeJS",
    "author": "aljazmc",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/threejs-landscapes.git"
    },
    "dependencies": {
        "@aljazmc/bloodmoon": "workspace:*",
        "@aljazmc/hullbreach": "workspace:*",
        "@aljazmc/moonshadow": "workspace:*",
        "@aljazmc/ptuj": "workspace:*",
        "@aljazmc/starter": "workspace:*"
    },
    "devDependencies": {
        "@aljazmc/formatero": "^0.7.0",
        "@aljazmc/lintero": "^0.7.0",
        "@aljazmc/monorepo": "^0.5.2",
        "@aljazmc/testero": "^0.4.2",
        "esbuild": "0.28.2",
        "typescript": "^7.0.2",
        "unrs-resolver": "^1.13.0"
    },
    "resolutions": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/three": "0.187.0",
        "esbuild": "0.28.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "three": "0.187.0",
        "unrs-resolver": "1.13.0"
    },
    "packageManager": "yarn@4.18.1",
    "workspaces": [
        "packages/**"
    ],
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || ^24 || ^25 || ^26",
        "npm": "Please use yarn instead of NPM to install dependencies",
        "pnpm": "Please use yarn instead of PNPM to install dependencies",
        "yarn": ">=4.12.0"
    },
    "scripts": {
        "b:all": "yarn workspaces foreach -A run build",
        "b:bloodmoon": "yarn workspace @aljazmc/bloodmoon run build",
        "b:hullbreach": "yarn workspace @aljazmc/hullbreach run build",
        "b:moonshadow": "yarn workspace @aljazmc/moonshadow run build",
        "b:ptuj": "yarn workspace @aljazmc/ptuj run build",
        "b:starter": "yarn workspace @aljazmc/starter run build",
        "bp:all": "yarn workspaces foreach -A run build:p",
        "bp:bloodmoon": "yarn workspace @aljazmc/bloodmoon run build:p",
        "bp:hullbreach": "yarn workspace @aljazmc/hullbreach run build:p",
        "bp:moonshadow": "yarn workspace @aljazmc/moonshadow run build:p",
        "bp:ptuj": "yarn workspace @aljazmc/ptuj run build:p",
        "bp:starter": "yarn workspace @aljazmc/starter run build:p",
        "ct:all": "yarn workspaces foreach -A run checktypes",
        "ct:bloodmoon": "tsc -b --noEmit packages/bloodmoon",
        "ct:hullbreach": "tsc -b --noEmit packages/hullbreach",
        "ct:moonshadow": "tsc -b --noEmit packages/moonshadow",
        "ct:ptuj": "tsc -b --noEmit packages/ptuj",
        "ct:starter": "tsc -b --noEmit packages/starter",
        "lint": "lintero && formatero",
        "lint:w": "lintero --write && formatero --write",
        "lint:wu": "lintero --write --unsafe && formatero --write",
        "s:bloodmoon": "yarn workspace @aljazmc/bloodmoon run serve",
        "s:hullbreach": "yarn workspace @aljazmc/hullbreach run serve",
        "s:moonshadow": "yarn workspace @aljazmc/moonshadow run serve",
        "s:ptuj": "yarn workspace @aljazmc/ptuj run serve",
        "s:starter": "yarn workspace @aljazmc/starter run serve",
        "sp:bloodmoon": "yarn workspace @aljazmc/bloodmoon run serve:p",
        "sp:hullbreach": "yarn workspace @aljazmc/hullbreach run serve:p",
        "sp:moonshadow": "yarn workspace @aljazmc/moonshadow run serve:p",
        "sp:ptuj": "yarn workspace @aljazmc/ptuj run serve:p",
        "sp:starter": "yarn workspace @aljazmc/starter run serve:p",
        "test": "testero",
        "w:bloodmoon": "yarn workspace @aljazmc/bloodmoon run watch",
        "w:hullbreach": "yarn workspace @aljazmc/hullbreach run watch",
        "w:moonshadow": "yarn workspace @aljazmc/moonshadow run watch",
        "w:ptuj": "yarn workspace @aljazmc/ptuj run watch",
        "w:starter": "yarn workspace @aljazmc/starter run watch"
    }
}
