{
    "name": "@aljazmc/moonshadow",
    "version": "0.2.0",
    "description": "Moonshadow Keep: a first person shooter against ten monsters in an elven keep",
    "author": "aljazmc",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/threejs-landscapes.git",
        "directory": "packages/moonshadow"
    },
    "dependencies": {
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@types/three": "^0.186.0"
    },
    "packageManager": "yarn@4.18.0",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || ^24 || ^25 || ^26"
    },
    "scripts": {
        "build": "esbuild src/index.{css,html,ts} src/res/* --loader:.glb=copy --loader:.png=copy --loader:.ogg=copy --loader:.mp3=copy --loader:.txt=copy --loader:.wav=copy --outbase=src --bundle --loader:.html=copy --format=esm --target=es2022 --outdir=dist",
        "build:p": "esbuild src/index.{ts,css} src/res/* --loader:.glb=copy --loader:.png=copy --loader:.ogg=copy --loader:.mp3=copy --loader:.txt=copy --loader:.wav=copy --outbase=src --bundle --minify --format=esm --target=es2022 --external:three '--external:three/addons/*' --outdir=dist && esbuild src/prod/index.html --loader:.html=copy --outdir=dist --outbase=src/prod",
        "checktypes": "yarn ct:moonshadow",
        "serve": "esbuild src/index.{css,html,ts} src/res/* --loader:.glb=copy --loader:.png=copy --loader:.ogg=copy --loader:.mp3=copy --loader:.txt=copy --loader:.wav=copy --outbase=src --bundle --loader:.html=copy --format=esm --target=es2022 --outdir=dist --serve",
        "serve:p": "yarn build:p && esbuild --servedir=dist --serve",
        "watch": "esbuild src/index.{css,html,ts} src/res/* --loader:.glb=copy --loader:.png=copy --loader:.ogg=copy --loader:.mp3=copy --loader:.txt=copy --loader:.wav=copy --outbase=src --bundle --loader:.html=copy --format=esm --target=es2022 --outdir=dist --serve --watch"
    }
}
