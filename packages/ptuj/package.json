{
    "name": "@aljazmc/ptuj",
    "version": "0.0.0",
    "description": "Medieval town simulation",
    "author": "aljazmc",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/aljazmc/threejs-landscapes.git",
        "directory": "packages/ptuj"
    },
    "dependencies": {
        "@react-three/fiber": "^9.7.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/three": "^0.185.4"
    },
    "packageManager": "yarn@4.13.0",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || ^24 || ^25 || ^26"
    },
    "scripts": {
        "build": "esbuild src/index.{css,html,tsx} --bundle --loader:.html=copy --platform=node --format=esm --target=es2022 --outdir=dist",
        "build:p": "esbuild src/index.{tsx,css} --bundle --platform=node --format=esm --target=es2022 --outdir=dist  --external:react --external:react-dom --external:three --external:@react-three/fiber --outdir=dist && esbuild src/prod/index.html --loader:.html=copy --outdir=dist --outbase=src/prod",
        "checktypes": "yarn ct:ptuj",
        "serve": "esbuild src/index.{css,html,tsx} --bundle --loader:.html=copy --outdir=dist --serve",
        "serve:p": "yarn build:p && esbuild dist/** --loader:.html=copy --outdir=dist --servedir=dist --serve",
        "watch": "esbuild src/index.{css,html,tsx} --bundle --loader:.html=copy --outdir=dist --serve --watch"
    }
}
